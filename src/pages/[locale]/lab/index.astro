---
import Base from '../../../layouts/Base.astro';
import Showcase from '../../../components/Showcase.astro';
import { locales, ui, type Locale } from '../../../lib/i18n';
export function getStaticPaths() { return locales.map(locale => ({ params: { locale } })); }
const locale = Astro.params.locale as Locale;
---
<Base locale={locale} active="lab" title={`${ui(locale).lab} · ByteDesk`} description={locale === 'zh' ? '新奇想法、界面与可交互的小实验。' : 'Ideas, interfaces and interactive experiments.'} alternateHref={`/${locale === 'zh' ? 'en' : 'zh'}/lab/`}><Showcase locale={locale} kind="lab"/></Base>
